          - Key: 6
            Value: "\u5C06\u5355\u8BCD\u6DFB\u52A0\u5230\u7C7B\u522B\u4E2D"
          - Key: 10
            Value: Add a word to a category
          - Key: 14
            Value: "Ajouter un mot \xE0 une cat\xE9gorie"
          - Key: 15
            Value: "Ein Wort zu einer Kategorie hinzuf\xFCgen"
          - Key: 20
            Value: Tambahkan kata ke kategori
          - Key: 21
            Value: Aggiungi una parola a una categoria
          - Key: 22
            Value: "\u30AB\u30C6\u30B4\u30EA\u306B\u5358\u8A9E\u3092\u8FFD\u52A0\u3059\u308B"
          - Key: 23
            Value: "\uCE74\uD14C\uACE0\uB9AC\uC5D0 \uB2E8\uC5B4 \uCD94\uAC00"
          - Key: 28
            Value: Adicionar uma palavra a uma categoria
          - Key: 30
            Value: "\u0414\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u0441\u043B\u043E\u0432\u043E
              \u0432 \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u044E"
          - Key: 34
            Value: "A\xF1adir una palabra a una categor\xEDa"
          - Key: 36
            Value: "\u0E40\u0E1E\u0E34\u0E48\u0E21\u0E04\u0E33\u0E25\u0E07\u0E43\u0E19\u0E2B\u0E21\u0E27\u0E14\u0E2B\u0E21\u0E39\u0E48"
