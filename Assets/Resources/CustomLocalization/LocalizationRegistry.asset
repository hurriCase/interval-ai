    - Key: 9d700e0f-3b09-4886-a36b-be604b217d34
      Value:
        <Key>k__BackingField: ui.learning-words.progress.title-zero
        <GUID>k__BackingField: 9d700e0f-3b09-4886-a36b-be604b217d34
        <TableName>k__BackingField: learning-words-progress-descriptions
        <Translations>k__BackingField:
          _serializedList:
          - Key: 6
            Value: "\u8BA9\u6211\u4EEC\u5F00\u59CB\u5B66\u4E60\u5427\uFF01"
          - Key: 10
            Value: Let's start learning!
          - Key: 14
            Value: "Commen\xE7ons \xE0 apprendre !"
          - Key: 15
            Value: Fangen wir an zu lernen!
          - Key: 20
            Value: Ayo mulai belajar!
          - Key: 21
            Value: Cominciamo ad imparare!
          - Key: 22
            Value: "\u5B66\u7FD2\u3092\u59CB\u3081\u307E\u3057\u3087\u3046\uFF01"
          - Key: 23
            Value: "\uD559\uC2B5\uC744 \uC2DC\uC791\uD574 \uBCF4\uC138\uC694!"
          - Key: 28
            Value: "Vamos come\xE7ar a aprender!"
          - Key: 30
            Value: "\u041D\u0430\u0447\u0438\u043D\u0430\u0435\u043C \u0438\u0437\u0443\u0447\u0435\u043D\u0438\u0435!"
          - Key: 34
            Value: "\xA1Empecemos a aprender!"
          - Key: 36
            Value: "\u0E21\u0E32\u0E40\u0E23\u0E34\u0E48\u0E21\u0E40\u0E23\u0E35\u0E22\u0E19\u0E23\u0E39\u0E49\u0E01\u0E31\u0E19\u0E40\u0E25\u0E22!"
    - Key: 07c86504-ed27-41e3-af2a-e7f69a903b67
      Value:
        <Key>k__BackingField: ui.learning-words.progress.title-zero-ready
        <GUID>k__BackingField: 07c86504-ed27-41e3-af2a-e7f69a903b67
        <TableName>k__BackingField: learning-words-progress-descriptions
        <Translations>k__BackingField:
          _serializedList:
          - Key: 6
            Value: "\u51C6\u5907\u51FA\u53D1\uFF01"
          - Key: 10
            Value: Ready to go!
          - Key: 14
            Value: "Pr\xEAt \xE0 partir !"
          - Key: 15
            Value: Bereit zum Loslegen!
          - Key: 20
            Value: Siap berangkat!
          - Key: 21
            Value: Pronti a partire!
          - Key: 22
            Value: "\u51FA\u767A\u6E96\u5099\u5B8C\u4E86\uFF01"
          - Key: 23
            Value: "\uCD9C\uBC1C \uC900\uBE44 \uC644\uB8CC!"
          - Key: 28
            Value: Pronto para ir!
          - Key: 30
            Value: "\u0413\u043E\u0442\u043E\u0432\u044B \u043A \u0441\u0442\u0430\u0440\u0442\u0443!"
          - Key: 34
            Value: "\xA1Listo para ir!"
          - Key: 36
            Value: "\u0E1E\u0E23\u0E49\u0E2D\u0E21\u0E25\u0E38\u0E22!"
    - Key: c96fea40-313f-42a5-9171-b15a9b723348
      Value:
        <Key>k__BackingField: ui.learning-words.progress.title-zero-lets-go
        <GUID>k__BackingField: c96fea40-313f-42a5-9171-b15a9b723348
        <TableName>k__BackingField: learning-words-progress-descriptions
        <Translations>k__BackingField:
          _serializedList:
          - Key: 6
            Value: "\u8BA9\u6211\u4EEC\u5F00\u59CB\u5427\uFF01"
          - Key: 10
            Value: Let's get started!
          - Key: 14
            Value: C'est parti !
          - Key: 15
            Value: Lass uns anfangen!
          - Key: 20
            Value: Ayo kita mulai!
          - Key: 21
            Value: Cominciamo!
          - Key: 22
            Value: "\u3055\u3042\u3001 \u59CB\u3081\u307E\u3057\u3087\u3046\uFF01"
          - Key: 23
            Value: "\uC2DC\uC791\uD574 \uBCFC\uAE4C\uC694!"
          - Key: 28
            Value: "Vamos come\xE7ar!"
          - Key: 30
            Value: "\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u043D\u0430\u0447\u043D\u0451\u043C!"
          - Key: 34
            Value: "\xA1Comencemos!"
          - Key: 36
            Value: "\u0E40\u0E23\u0E34\u0E48\u0E21\u0E01\u0E31\u0E19\u0E40\u0E25\u0E22!"
    - Key: bbdd177f-05da-43a6-bb6c-6a80202e95fd
      Value:
        <Key>k__BackingField: ui.learning-words.progress.title-low
        <GUID>k__BackingField: bbdd177f-05da-43a6-bb6c-6a80202e95fd
        <TableName>k__BackingField: learning-words-progress-descriptions
        <Translations>k__BackingField:
          _serializedList:
          - Key: 6
            Value: "\u597D\u7684\u5F00\u59CB\uFF01"
          - Key: 10
            Value: Good start!
          - Key: 14
            Value: "Bon d\xE9but !"
          - Key: 15
            Value: Guter Start!
          - Key: 20
            Value: Awal yang bagus!
          - Key: 21
            Value: Buon inizio!
          - Key: 22
            Value: "\u826F\u3044\u30B9\u30BF\u30FC\u30C8\u3067\u3059\uFF01"
          - Key: 23
            Value: "\uC88B\uC740 \uC2DC\uC791\uC774\uC5D0\uC694!"
          - Key: 28
            Value: "Bom come\xE7o!"
          - Key: 30
            Value: "\u0425\u043E\u0440\u043E\u0448\u0435\u0435 \u043D\u0430\u0447\u0430\u043B\u043E!"
          - Key: 34
            Value: "\xA1Buen comienzo!"
          - Key: 36
            Value: "\u0E40\u0E23\u0E34\u0E48\u0E21\u0E15\u0E49\u0E19\u0E44\u0E14\u0E49\u0E14\u0E35!"
    - Key: deceba8b-8908-4600-be26-7481b010ae21
      Value:
        <Key>k__BackingField: ui.learning-words.progress.title-low-momentum
        <GUID>k__BackingField: deceba8b-8908-4600-be26-7481b010ae21
        <TableName>k__BackingField: learning-words-progress-descriptions
        <Translations>k__BackingField:
          _serializedList:
          - Key: 6
            Value: "\u52A0\u5FEB\u6B65\u4F10\uFF01"
          - Key: 10
            Value: Picking up the pace!
          - Key: 14
            Value: "On acc\xE9l\xE8re le rythme !"
          - Key: 15
            Value: "Das Tempo erh\xF6hen!"
          - Key: 20
            Value: Mempercepat langkah!
          - Key: 21
            Value: Accelerando il passo!
          - Key: 22
            Value: "\u30DA\u30FC\u30B9\u304C\u4E0A\u304C\u3063\u3066\u304D\u307E\u3057\u305F\uFF01"
          - Key: 23
            Value: "\uC18D\uB3C4\uB97C \uB192\uC774\uC138\uC694!"
          - Key: 28
            Value: Acelerando o ritmo!
          - Key: 30
            Value: "\u041D\u0430\u0431\u0438\u0440\u0430\u0435\u043C \u0442\u0435\u043C\u043F!"
          - Key: 34
            Value: "\xA1Acelerando el ritmo!"
          - Key: 36
            Value: "\u0E40\u0E23\u0E34\u0E48\u0E21\u0E40\u0E23\u0E48\u0E07\u0E1D\u0E35\u0E40\u0E17\u0E49\u0E32\u0E41\u0E25\u0E49\u0E27!"
    - Key: 3e424bb4-ba1e-4f22-89ee-b451a2f4aa90
      Value:
        <Key>k__BackingField: ui.learning-words.progress.title-low-progress
        <GUID>k__BackingField: 3e424bb4-ba1e-4f22-89ee-b451a2f4aa90
        <TableName>k__BackingField: learning-words-progress-descriptions
        <Translations>k__BackingField:
          _serializedList:
          - Key: 6
            Value: "\u6709\u9032\u6B65\u4E86\uFF01"
          - Key: 10
            Value: There is progress!
          - Key: 14
            Value: "Il y a du progr\xE8s !"
          - Key: 15
            Value: Es gibt Fortschritte!
          - Key: 20
            Value: Ada kemajuan!
          - Key: 21
            Value: "C'\xE8 progresso!"
          - Key: 22
            Value: "\u9032\u6B69\u304C\u3042\u308A\u307E\u3059!"
          - Key: 23
            Value: "\uC9C4\uC804\uC774 \uC788\uB124\uC694!"
          - Key: 28
            Value: "H\xE1 progresso!"
          - Key: 30
            Value: "\u041F\u0440\u043E\u0433\u0440\u0435\u0441\u0441 \u0435\u0441\u0442\u044C!"
          - Key: 34
            Value: "\xA1Hay progreso!"
          - Key: 36
            Value: "\u0E21\u0E35\u0E04\u0E27\u0E32\u0E21\u0E04\u0E37\u0E1A\u0E2B\u0E19\u0E49\u0E32\u0E41\u0E25\u0E49\u0E27!"
    - Key: 7abe7ce9-ec3c-483d-b09b-d19f5c1096f1
      Value:
        <Key>k__BackingField: ui.learning-words.progress.title-medium
        <GUID>k__BackingField: 7abe7ce9-ec3c-483d-b09b-d19f5c1096f1
        <TableName>k__BackingField: learning-words-progress-descriptions
        <Translations>k__BackingField:
          _serializedList:
          - Key: 6
            Value: "\u8FDB\u6B65\u5F88\u5927\uFF01"
          - Key: 10
            Value: Great progress!
          - Key: 14
            Value: "De grands progr\xE8s !"
          - Key: 15
            Value: "Gro\xDFartige Fortschritte!"
          - Key: 20
            Value: Kemajuan yang luar biasa!
          - Key: 21
            Value: Grandi progressi!
          - Key: 22
            Value: "\u7D20\u6674\u3089\u3057\u3044\u9032\u6B69\u3067\u3059\uFF01"
          - Key: 23
            Value: "\uD070 \uC9C4\uC804\uC774\uC5D0\uC694!"
          - Key: 28
            Value: Grande progresso!
          - Key: 30
            Value: "\u041E\u0442\u043B\u0438\u0447\u043D\u044B\u0439 \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441!"
          - Key: 34
            Value: "\xA1Gran progreso!"
          - Key: 36
            Value: "\u0E04\u0E27\u0E32\u0E21\u0E04\u0E37\u0E1A\u0E2B\u0E19\u0E49\u0E32\u0E14\u0E35\u0E21\u0E32\u0E01!"
    - Key: 35287b1a-f4de-4618-a18f-cbb924771630
      Value:
        <Key>k__BackingField: ui.learning-words.progress.title-medium-halfway
        <GUID>k__BackingField: 35287b1a-f4de-4618-a18f-cbb924771630
        <TableName>k__BackingField: learning-words-progress-descriptions
        <Translations>k__BackingField:
          _serializedList:
          - Key: 6
            Value: "\u534A\uFF01"
          - Key: 10
            Value: Halfway!
          - Key: 14
            Value: "\xC0 mi-chemin !"
          - Key: 15
            Value: Halb!
          - Key: 20
            Value: Setengah jalan!
          - Key: 21
            Value: "A met\xE0 strada!"
          - Key: 22
            Value: "\u534A\u5206\u307E\u3067\u6765\u307E\u3057\u305F\uFF01"
          - Key: 23
