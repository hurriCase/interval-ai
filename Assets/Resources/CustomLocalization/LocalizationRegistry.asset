        <GUID>k__BackingField: 02d5e457-6fb1-4797-9300-1c09eea4f241
        <TableName>k__BackingField: word-info
        <Translations>k__BackingField:
          _serializedList:
          - Key: 6
            Value: "\u5F00\u59CB\u5B66\u4E60\u8FD9\u4E2A\u8BCD"
          - Key: 10
            Value: Start learning the word
          - Key: 14
            Value: "Commencez \xE0 apprendre le mot"
          - Key: 15
            Value: Beginnen Sie, das Wort zu lernen
          - Key: 20
            Value: Mulailah belajar kata tersebut
          - Key: 21
            Value: Inizia ad imparare la parola
          - Key: 22
            Value: "\u5358\u8A9E\u306E\u5B66\u7FD2\u3092\u59CB\u3081\u308B"
          - Key: 23
            Value: "\uB2E8\uC5B4\uB97C \uBC30\uC6B0\uAE30 \uC2DC\uC791\uD558\uC138\uC694"
          - Key: 28
            Value: Comece a aprender a palavra
          - Key: 30
            Value: "\u041D\u0430\u0447\u0430\u0442\u044C \u0438\u0437\u0443\u0447\u0435\u043D\u0438\u044F
              \u0441\u043B\u043E\u0432\u0430"
          - Key: 34
            Value: Empieza a aprender la palabra
          - Key: 36
            Value: "\u0E40\u0E23\u0E34\u0E48\u0E21\u0E40\u0E23\u0E35\u0E22\u0E19\u0E23\u0E39\u0E49\u0E04\u0E33\u0E28\u0E31\u0E1E\u0E17\u0E4C"
    - Key: 25aff2c1-3323-4fe8-8c81-645442a07985
      Value:
