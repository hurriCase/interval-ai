        <Translations>k__BackingField:
          _serializedList:
          - Key: 6
            Value: "\u975E\u5E38\u597D\uFF0C\u6CA1\u6709\u9519\u8BEF\uFF01"
          - Key: 10
            Value: Excellent, no errors!
          - Key: 14
            Value: Excellent, aucune erreur !
          - Key: 15
            Value: Ausgezeichnet, keine Fehler!
          - Key: 20
            Value: Luar biasa, tidak ada kesalahan!
          - Key: 21
            Value: Ottimo, nessun errore!
          - Key: 22
            Value: "\u7D20\u6674\u3089\u3057\u3044\u3001 \u30A8\u30E9\u30FC\u306A\u3057!"
          - Key: 23
            Value: "\uD6CC\uB96D\uD569\uB2C8\uB2E4. \uC624\uB958\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4!"
          - Key: 28
            Value: Excelente, sem erros!
          - Key: 30
            Value: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E, \u0431\u0435\u0437
              \u043E\u0448\u0438\u0431\u043E\u043A!"
          - Key: 34
            Value: "\xA1Excelente, sin errores!"
          - Key: 36
            Value: "\u0E40\u0E22\u0E35\u0E48\u0E22\u0E21\u0E21\u0E32\u0E01 \u0E44\u0E21\u0E48\u0E21\u0E35\u0E02\u0E49\u0E2D\u0E1C\u0E34\u0E14\u0E1E\u0E25\u0E32\u0E14!"
