<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Portable.System.DateTimeOnly</id>
    <version>9.0.1</version>
    <authors>Oleg Rakhmatulin</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>icon.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/OlegRa/System.DateTimeOnly</projectUrl>
    <description>DateOnly and TimeOnly types for .NET versions before 6.0</description>
    <releaseNotes>- The `System.Memory` package was upgraded from version 4.6.0 to version 4.6.3 for better compatibility.</releaseNotes>
    <copyright>© 2021-2025 Oleg Rakhmatulin. All rights reserved.</copyright>
    <tags>DateOnly TimeOnly</tags>
    <repository type="git" url="https://github.com/OlegRa/System.DateTimeOnly" commit="87f3e2b29b151b3ab12c84c7657ee5a722b0b096" />
    <dependencies>
      <group targetFramework=".NETFramework4.6.2">
        <dependency id="System.Memory" version="4.6.3" exclude="Compile,Build,Analyzers" />
      </group>
      <group targetFramework="net6.0" />
      <group targetFramework=".NETStandard2.0">
        <dependency id="System.Memory" version="4.6.3" exclude="Compile,Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.1" />
    </dependencies>
  </metadata>
</package>